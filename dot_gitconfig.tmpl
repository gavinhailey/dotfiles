[user]
  name  = Gavin Hailey
  email = {{ .email | quote }}
[core]
  pager = delta
[interactive]
  diffFilter = delta --color-only
[diff]
  colorMoved = default
  algorithm  = histogram
[delta]
  navigate     = true
  line-numbers = true
[merge]
  conflictStyle = zdiff3
[fetch]
  prune     = true
  pruneTags = true
[push]
  autoSetupRemote = true
[alias]
  uncommit = reset HEAD^
[pull]
  rebase = false
[init]
  defaultBranch = main
[include]
  path = ~/.config/git/tokyonight.gitconfig
[url "ssh://git@github.com/"]
  insteadOf = https://github.com/

