if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# environment variables
export ZLE_RPROMPT_INDENT=0

zstyle ':completion:*' completer _complete _ignored _approximate
autoload -Uz compinit
compinit

zstyle ':omz:update' mode disabled
ENABLE_CORRECTION="false" 
export FZF_COMPLETION_OPTS='--border --info=inline'

{{if eq .chezmoi.os "darwin" -}}
source $(brew --prefix)/opt/antidote/share/antidote/antidote.zsh
{{else if eq .chezmoi.os "linux" -}}
source /usr/share/zsh-antidote/antidote.zsh
{{- end}}
antidote load

if [[ "$(uname)" == "Darwin" ]]; then 
  zvm_after_init_commands+=('source <(fzf --zsh) ') # MacOS
else
  zvm_after_init_commands+=('[ -f ~/.fzf.zsh ] && source ~/.fzf.zsh') # Linux
fi

export GPG_TTY=$(tty)

### disable sort when completing `git checkout`
zstyle ':completion:*:git-checkout:*' sort false
### set descriptions format to enable group support
zstyle ':completion:*:descriptions' format '[%d]'
### set list-colors to enable filename colorizing
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
### switch group using `,` and `.`
zstyle ':fzf-tab:*' switch-group ',' '.'

## default editor for local and remote sessions
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='nvim'
fi
export VISUAL=$EDITOR

## aliases

### general
alias cat="bat"
alias vim="nvim"
alias vi="nvim"
alias ls="eza -a"
alias la="eza -al --git --no-user"
alias gg-dependabot="gh combine-prs --query 'author:app/dependabot'"
alias epoch="date +%s"
alias zshrc="chezmoi edit ~/.zshrc --apply"

{{- if eq .host "work" }}
### credentials
export ARTIFACTORY_USER=$(keychain-environment-variable ARTIFACTORY_USER)
export ARTIFACTORY_TOKEN=$(keychain-environment-variable ARTIFACTORY_TOKEN)
export JFROG_ACCESS_TOKEN=$(keychain-environment-variable ARTIFACTORY_TOKEN)
export NPM_REPO_USERNAME=$(keychain-environment-variable ARTIFACTORY_USER)
export NPM_REPO_PASSWORD=$(keychain-environment-variable ARTIFACTORY_TOKEN)
export NPM_REPO_LOGIN="${ARTIFACTORY_USER}:${ARTIFACTORY_TOKEN}"
export GEM_REPO_LOGIN="${ARTIFACTORY_USER}:${ARTIFACTORY_TOKEN}"
export MVN_REPO_LOGIN="${ARTIFACTORY_USER}:${ARTIFACTORY_TOKEN}"
export DD_PAT=$(keychain-environment-variable DD_PAT)
export HOMEBREW_GITHUB_API_TOKEN=$(gh auth token)
export GIT_PAT_TOKEN=$(gh auth token)
export ATLASSIAN_API_TOKEN=$(keychain-environment-variable ATLASSIAN_PAT_P1)$(keychain-environment-variable ATLASSIAN_PAT_P2)
export ATLASSIAN_USERNAME=$(keychain-environment-variable ATLASSIAN_USERNAME)
export JIRA_EMAIL=${ATLASSIAN_USERNAME}
export JIRA_API_TOKEN=${ATLASSIAN_PAT}
export JIRA_URL=$(keychain-environment-variable ATLASSIAN_URL)
export CONFLUENCE_URL=$(keychain-environment-variable ATLASSIAN_URL)/wiki
{{- end }}

{{- if eq .host "personal" }}
{{- end }}

### aws qol
export AWS_FEDERATION_TOKEN_TTL=12h
export AWS_ASSUME_ROLE_TTL=1h
export AWS_DEFAULT_REGION=us-east-1
export AWS_SESSION_TTL=12h
export AWS_REGION=us-east-1

### xdg
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_STATE_HOME="$HOME/.local/state"

### redirect to xdg
export SQLITE_HISTORY=$XDG_STATE_HOME/sqlite_history
export LESSHISTFILE=$XDG_STATE_HOME/less_history
export PYTHON_HISTORY=$XDG_STATE_HOME/python_history
export JUPYTER_CONFIG_DIR=$XDG_CONFIG_HOME/jupyter


{{- if eq .host "work" }}
export SSL_CERT_FILE=$XDG_DATA_HOME/ca-certificates/zscaler.crt
{{- end }}

### path stuffs
export PATH="$HOME/.local/bin:$PATH"
{{if eq .chezmoi.os "darwin" -}}
export PATH="/opt/homebrew/opt/gawk/libexec/gnubin:$PATH"
export PATH="/opt/homebrew/opt/gnu-sed/libexec/gnubin:$PATH"
export PATH="/opt/homebrew/opt/grep/libexec/gnubin:$PATH"
export PATH="/opt/homebrew/opt/gnu-getopt/bin:$PATH"
export PATH="$(brew --prefix libpq)/bin:$PATH"
export PATH="$HOME/.moon/bin:$PATH"
export PATH="$(brew --prefix llvm@21)/bin:$PATH"
{{- end }}

## completions 

### lefthook
if command -v lefthook &> /dev/null; then
  eval "$(lefthook completion zsh)"
fi

### switch
if command -v switcher &> /dev/null; then
  source <(switcher init zsh)
  source <(switch completion zsh)
fi

### ngrok
if command -v ngrok &>/dev/null; then
  eval "$(ngrok completion)"
fi

### chezmoi
if command -v chezmoi &> /dev/null; then
  source <(chezmoi completion zsh)
fi

### mise
if command -v mise &> /dev/null; then
  eval "$(mise activate zsh)"
fi

### wt
if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi

### uv
if command -v uv &> /dev/null; then
  eval "$(uv generate-shell-completion zsh)"
  eval "$(uvx --generate-shell-completion zsh)"
fi

### rust
export PATH=$PATH:$HOME/.cargo/bin

### golang
export GOPATH="$HOME/.go"
export GOBIN="$HOME/.local/bin"

### bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

### deno
if [[ -f "~/.deno/env" ]]; then
  source "~/.deno/env"
fi

# pnpm
{{ if eq .chezmoi.os "darwin" -}}
export PNPM_HOME="$HOME/Library/pnpm"
{{ else if eq .chezmoi.os "linux" -}}
export PNPM_HOME="$HOME/.local/share/pnpm"
{{end -}}
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac
# pnpm end

# zoxide
eval "$(zoxide init zsh --cmd cd --hook pwd)"

# powerlevel10k
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

